<% layout('layouts/boilerplate') -%>

  <div class="row">
    <div class="col-6 offset-3">
      <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Error!</h4>
        <p class="mb-0">Status Code: <%= err.statusCode %>
        </p>
        <p>
          <%= err.message %>
        </p>
        <% if(process.env.NODE_ENV !== 'production') { %>
         <p>
           <%= err.stack %>
         </p>
        <% } %>
      </div>
    </div>
  </div>