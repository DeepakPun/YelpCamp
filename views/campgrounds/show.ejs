<% layout('layouts/boilerplate') %>
<link rel="stylesheet" href="/styles/stars.css">

<div class="row g-4">
  <!-- Left Column: Campground Details -->
  <div class="col-12 col-lg-6">
    <div class="card shadow-sm border-0">
      <% if(campground.images.length) { %>
      <div id="campgroundCarousel" class="carousel slide">
        <div class="carousel-inner rounded-top">
          <% campground.images.forEach((img, i)=> { %>
          <div class="carousel-item <%= i === 0 ? 'active' : '' %>">
            <img src="<%= img.url %>" class="d-block w-100" alt="<%= campground.title %>">
          </div>
          <% }) %>
        </div>
        <% if(campground.images.length > 1) { %>
        <button class="carousel-control-prev" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="prev">
          <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#campgroundCarousel" data-bs-slide="next">
          <span class="carousel-control-next-icon"></span>
        </button>
        <% } %>
      </div>
      <% } %>
      <div class="card-body">
        <h4 class="card-title fw-bold"> <%= campground.title %> </h4>
        <p class="card-text text-muted"> <%= campground.description %> </p>
      </div>
      <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted"><i class="bi bi-geo-alt"></i> Location</span>
          <span class="fw-semibold"> <%= campground.location %> </span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted"><i class="bi bi-person"></i> Author</span>
          <span class="fw-semibold"> <%= campground.author.username %> </span>
        </li>
        <li class="list-group-item d-flex justify-content-between">
          <span class="text-muted"><i class="bi bi-currency-dollar"></i> Price</span>
          <span class="fw-bold">$<%= campground.price %> / night</span>
        </li>
      </ul>
      <% if (currentUser && currentUser._id.equals(campground.author._id)) { %>
      <div class="card-body d-flex gap-2">
        <a href="/campgrounds/<%= campground._id %>/edit" class="btn btn-sm btn-info">Edit</a>
        <form action="/campgrounds/<%= campground._id %>?_method=DELETE" method="POST" class="m-0">
          <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this campground?')">Delete</button>
        </form>
      </div>
      <% } %>
    </div>
  </div>

  <!-- Right Column: Map, Review CTA, and Review Feed -->
  <div class="col-12 col-lg-6">
    <!-- Map Container Box Only -->
    <div class="card shadow-sm border-1 mb-4">
      <div class="card-body p-2">
        <div id="map" style="height: 300px; width: 100%;"></div>
      </div>
    </div>

    <!-- Review Input Box (Separated from Map) -->
    <div class="card shadow-sm border-1 mb-4">
      <div class="card-body">
        <% if (currentUser) { %>
        <h5 class="card-title mb-3">Leave a Review</h5>
        <form novalidate class="needs-validation" action="/campgrounds/<%= campground._id %>/reviews" method="POST">
          <!-- Force stars to stay layout-linear on single line -->
          <div class="mb-3 d-flex flex-wrap align-items-center">
            <fieldset class="starability-basic d-flex flex-nowrap m-0" style="min-height: auto;">
              <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" aria-label="No rating." />
              <input type="radio" id="first-rate1" name="review[rating]" value="1" required />
              <label for="first-rate1" title="Terrible">1 star</label>
              <input type="radio" id="first-rate2" name="review[rating]" value="2" />
              <label for="first-rate2" title="Not good">2 stars</label>
              <input type="radio" id="first-rate3" name="review[rating]" value="3" />
              <label for="first-rate3" title="Average">3 stars</label>
              <input type="radio" id="first-rate4" name="review[rating]" value="4" />
              <label for="first-rate4" title="Very good">4 stars</label>
              <input type="radio" id="first-rate5" name="review[rating]" value="5" />
              <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
          </div>
          <div class="mb-3">
            <label for="review" class="form-label">Review Description</label>
            <textarea class="form-control" id="review" name="review[body]" rows="3" required></textarea>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please enter a review.</div>
          </div>
          <button class="btn btn-success">Submit Review</button>
        </form>
        <% } else { %>
          <div class="card-body">
            <h5>
              <a href="/login" class="text-decoration-none border-bottom border-5 pb-1">Login</a> to leave a review
            </h5>
            <p class="text-muted small mt-3">Share your experience with others.</p>
            <!-- <a href="/login" class="btn btn-primary">Login</a> -->
          </div>
        <% } %>
      </div>
    </div>

    <!-- Existing Reviews Block -->
    <% if (campground.reviews && campground.reviews.length > 0) { %>
    <h5 class="mb-3">Reviews <span class="badge bg-secondary rounded-pill fw-normal"> <%= campground.reviews.length %> </span></h5>
    <% for(let review of campground.reviews) { %>
    <div class="card mb-3 shadow-sm border-2">
      <div class="card-body">
        <div class="d-flex justify-content-between align-items-start mb-2">
          <div>
            <h6 class="mb-1 fw-semibold"> <%= review.author?.username || 'Deleted user' %> </h6>
            <p class="starability-result mb-0" data-rating="<%= review.rating %>">Rated <%= review.rating %> stars</p>
          </div>
          <% if(currentUser && review.author && currentUser._id.equals(review.author._id)) { %>
          <form action="/campgrounds/<%= campground._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST">
            <button class="btn btn-sm btn-outline-danger border-0" onclick="return confirm('Delete this review?')"><i class="bi bi-trash"></i></button>
          </form>
          <% } %>
        </div>
        <p class="card-text mt-2 mb-0"> <%= review.body %> </p>
      </div>
    </div>
    <% } %>
    <% } else { %>
    <div class="text-center py-4 bg-light rounded shadow-sm border mb-3">
      <h6>Reviews</h6>
      <p class="text-muted fst-italic small mb-0">No reviews yet. Be the first!</p>
    </div>
    <% } %>
  </div>
</div>

<%-"<script>"%>
const maptilerApiKey = '<%- process.env.MAPTILER_API_KEY %>'
const campground = <%- JSON.stringify(campground) %>
<%-"</script>"%>
<script src="/javascripts/showPageMap.js"></script>
<script defer src="/javascripts/clusterMap.js"></script>
