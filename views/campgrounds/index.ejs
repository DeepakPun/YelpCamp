<% layout('layouts/boilerplate') %>
    <div id="cluster-map"></div>
    <% if(campgrounds?.length && campgrounds?.length>0){ %>
    <h1>All Campgrounds </h1>
    <% for(let campground of campgrounds) { %>
        <div class="card mb-3">
            <div class="row">
                <div class="col-md-4">
                    <img class="img-fluid w-100 h-100" src="<%= campground.images[0].url %>"
                        alt="<%= campground.title %>">
                </div>
                <div class="col-md-8">
                    <div class="card-body">
                        <h5 class="card-title">
                            <%= campground.title %>
                        </h5>
                        <p class="card-text">
                            <%= campground.description %>
                        </p>
                        <p class="card-text"><strong>Price:</strong> $<%= campground.price %>
                        </p>
                        <p class="card-text">
                            <small class="text-muted">
                                <%= campground.location %>
                            </small>
                        </p>
                        <a href="/campgrounds/<%= campground._id %>" class="btn btn-primary">View Campground</a>
                    </div>
                </div>
            </div>
        </div>
        <% } %>
        <% } %>

            <%- "<script>" %>
                const maptilerApiKey = "<%- process.env.MAPTILER_API_KEY %>";
                    const campgrounds = {
                    type: "FeatureCollection",
                    features: <%- JSON.stringify( campgrounds.map(campground=> ({
                        type: "Feature",
                        geometry: campground.geometry,
                        properties: { popUpMarkup: campground?.properties?.popUpMarkup }
                        }))
                        ) %>
                        };
                        <%- "</script>" %>

                            <script src="/javascripts/clusterMap.js"></script>
                            <script defer src="/javascripts/clusterMap.js"></script>