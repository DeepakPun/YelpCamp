<% layout('layouts/boilerplate') %>

    <div class="row">
        <div class="col-6 offset-3">
            <h1 class="">Edit campground</h1>
            <form action="/campgrounds/<%= campground._id %>?_method=PUT" method="POST">
                <div class="mb-3">
                    <label class="form-label mb-0" for="title">Title:</label>
                    <input type="text" name="campground[title]" id="title" class="form-control"
                        value="<%= campground.title %>">
                </div>
                <div class="mb-3">
                    <label class="form-label mb-0" for="image">Image URL:</label>
                    <input type="text" name="campground[image]" id="image" class="form-control"
                        value="<%= campground.image %>">
                </div>
                <div class="mb-3">
                    <label class="form-label mb-0" for="price">Price</label>
                    <div class="input-group">
                        <span class="input-group-text" id="inputGroup-sizing-default">$</span>
                        <input type="text" placeholder="0.00" name="campground[price]" id="price" class="form-control"
                            value="<%= campground.price %>">
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label mb-0" for="location">Location:</label>
                    <input type="text" name="campground[location]" id="location" class="form-control"
                        value="<%= campground.location %>">
                </div>
                <div class="mb-3">
                    <label class="form-label mb-0" for="description">Description:</label>
                    <textarea name="campground[description]" id="description" cols="30" rows="10"
                        class="form-control"><%= campground.description %></textarea>
                </div>
                <div class="my-3">
                    <button type="submit" class="btn btn-info">Update Campground</button>
                </div>
            </form>
            <a href="/campgrounds/<%= campground._id %>" class="btn btn-secondary">Back to campground</a>
        </div>
    </div>