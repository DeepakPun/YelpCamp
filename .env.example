SESSION_SECRET=<YOUR-SESSION-SECRET>
# run `openssl rand -hex 64` from the terminal and use the output as session secret. 

PORT=3000
NODE_ENV=development
CLOUDINARY_CLOUD_NAME=<YOUR-CLOUDINARY-CLOUD-NAME>
CLOUDINARY_KEY=<YOUR-CLOUDINARY-API-KEY>
CLOUDINARY_SECRET=<YOUR-CLOUDINARY-SECRET>
MONGO_URI=mongodb://localhost:27017/yelp-camp
# Atlas uri for production

# For YelpCamp-dev, localhost as allowed origin
MAPTILER_API_KEY=<YOUR-MAPTILER-KEY>